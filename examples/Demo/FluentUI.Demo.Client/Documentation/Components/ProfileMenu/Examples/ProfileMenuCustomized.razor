<FluentStack HorizontalAlignment="@HorizontalAlignment.End"
             VerticalAlignment="@VerticalAlignment.Center"
             Style="height: 48px; background: var(--neutral-layer-4); padding-inline-end: 10px; ">
    <FluentProfileMenu Initials="BG"
                       Style="--fluent-profile-menu-hover: var(--neutral-stroke-focus); padding: 4px;">
        <StartTemplate>
            @_person.FullName
        </StartTemplate>
        <HeaderTemplate>
            <FluentLabel Size="LabelSize.Medium">Login</FluentLabel>
        </HeaderTemplate>
        <ChildContent>
            <div style="width: 250px; height: 80px">
				<FluentLabel Size="LabelSize.Medium" Weight="LabelWeight.Semibold">@_person.FullName</FluentLabel>
                <FluentLabel>@_person.Email</FluentLabel>
            </div>
        </ChildContent>
        <FooterTemplate>
            <FluentStack>
                <FluentSpacer />
                <FluentAnchorButton
                              Href="https://microsoft.com"
                              Target="LinkTarget.Blank">About</FluentAnchorButton>
            </FluentStack>
        </FooterTemplate>
    </FluentProfileMenu>
</FluentStack>

@code {
	private People.Person _person = People.GeneratePerson();
}
